{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FX Anything",
  "version": "0.1.0",
  "identifier": "com.fxanything.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FX Anything",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "label": "main",
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Real-time effects on anything your PC plays",
    "longDescription": "FX Anything puts live effects (concert venues, 8D audio, pitch, DJ filter, reverb, echo, lo-fi, karaoke and more) on any app's audio routed through VB-CABLE.",
    "category": "Music",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
